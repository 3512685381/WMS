# DeepSeek 或兼容 OpenAI Chat Completions 的网关
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
# 默认使用 DeepSeek Flash。网关采用其他模型标识时，可在此覆盖。
# DEEPSEEK_MODEL=deepseek-flash

# 本地开发可读取 ../springboot/.env。这里可覆盖 FastAPI 自己的配置。
# JWT_SECRET=
# WMS_DB_HOST=127.0.0.1
# WMS_DB_PORT=3306
# WMS_DB_NAME=wms
# WMS_DB_USER=
# WMS_DB_PASSWORD=
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/wms
# CORS_ORIGINS=["http://localhost:5173"]
