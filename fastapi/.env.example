# DeepSeek 或兼容 OpenAI Chat Completions 的网关
DEEPSEEK_BASE_URL=http://127.0.0.1:3425/v1
DEEPSEEK_API_KEY=magpie
# 默认使用 DeepSeek Flash。网关采用其他模型标识时，可在此覆盖。
DEEPSEEK_MODEL=codex/gpt-6.1-sol

# MySQL 连接，使用与 Spring Boot 相同的 WMS 数据库。
WMS_DB_HOST=127.0.0.1
WMS_DB_PORT=3306
WMS_DB_NAME=wms
WMS_DB_USER=root
WMS_DB_PASSWORD='123456'

# 复制 springboot/.env 中 JWT_SECRET 的完整值，两端必须一致。
JWT_SECRET='wms-super-secret-jwt-key-change-in-prod-2026'

# 可选，设置后优先使用此 URL，凭据中的特殊字符须做 URL 编码。
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/wms
# CORS_ORIGINS=["http://localhost:5173"]
